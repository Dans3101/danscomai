# Copy to bridge/.env and fill in from the Accounts -> Bridge config panel.
APP_BASE_URL=https://your-app.lovable.app
ACCOUNT_ID=
BRIDGE_TOKEN=

# MT5 broker credentials live on the WINDOWS Companion (config.json).
# The Ubuntu backend never sees them.

# Backend selector: auto | remote | native | simulator
#   auto      — native on Windows, remote (Windows Companion) on Linux
#   remote    — talk to the Windows Companion through the local hub
#   simulator — run without a broker (dev/test mode)
MT5_BACKEND=auto

# ---- Companion Hub (Ubuntu) ----
# WebSocket endpoint the Windows Companion connects to.
HUB_HOST=0.0.0.0
HUB_WS_PORT=8765
# Optional: public URL the Windows Companion dials (informational for the hub).
COMPANION_WS_URL=
# Loopback JSON-RPC used by the bridge workers.
HUB_RPC_HOST=127.0.0.1
HUB_RPC_PORT=8766
RPC_TIMEOUT=30
# Accepted companion bridge tokens (comma separated). Defaults to BRIDGE_TOKEN.
COMPANION_TOKENS=
# Optional direct TLS (omit when nginx/caddy terminates TLS in front).
HUB_TLS_CERT=
HUB_TLS_KEY=

POLL_SECONDS=2
HEALTH_FILE=/tmp/mt5-bridge.health
LOG_LEVEL=INFO

# Prometheus metrics (scraped by Grafana)
METRICS_ENABLED=1
METRICS_PORT=9108